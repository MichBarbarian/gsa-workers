# Copy to .env for local runs (never commit .env)
SUPABASE_DB_URL=postgresql://...

# Provider group: etherscan | alchemy_k1 | bsc | xlayer
PROVIDER_GROUP=etherscan

ETHERSCAN_API_KEY=
# Base + Gnosis (do not reuse ALCHEMY_FREE_KEY from token discovery)
ALCHEMY_ACTIVITY_KEY_1=
# BSC day-1 cut — dedicated Alchemy Free app
ALCHEMY_ACTIVITY_KEY_2=
# BSC day-15 cut
ANKR_API_KEY=

# X Layer Data API HMAC (not Market API)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

WORKER_ID=etherscan
CLAIM_BATCH_SIZE=20
CLAIM_STALE_SECONDS=7200
MAX_RUNTIME_SECONDS=19800
