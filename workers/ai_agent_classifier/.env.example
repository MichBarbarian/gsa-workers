# Copy to .env for local runs (never commit .env)
SUPABASE_DB_URL=postgresql://...
# Env name must match llm.llm_provider.secret for the configured provider(s)
GROQ=your_groq_api_key
# CEREBRAS=...
# GEMINI=...
# NVIDIA=nvapi-...   # build.nvidia.com hosted NIM (ADR 2026-08-05)
# MISTRAL=...        # console.mistral.ai Experiment (ADR 2026-08-05)
# CLOUDFLARE=...     # Cloudflare API token (Workers AI + AI Gateway; ADR 2026-08-05)
CLAIM_BATCH_SIZE=20
REQUEUE_ERROR_BATCH_SIZE=1000
CONCURRENCY=1
MAX_RUNTIME_SECONDS=19800
